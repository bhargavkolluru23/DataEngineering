{
	"name": "dataflowSelect1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "invoiceDS",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "selectColoums"
				}
			],
			"scriptLines": [
				"source(output(",
				"          YEAR as short,",
				"          MONTH as short,",
				"          INVOICEID as string,",
				"          COUNTRY as string,",
				"          REGION as string,",
				"          SALES as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          YEAR,",
				"          MONTH,",
				"          COUNTRY,",
				"          SALES",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColoums",
				"selectColoums sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink"
			]
		}
	}
}