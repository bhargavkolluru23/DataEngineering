{
	"name": "dataflowSelect",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_InvoiceData",
						"type": "DatasetReference"
					},
					"name": "readDataflow"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "MapDrifted1",
					"description": "Creates an explicit mapping for each drifted column"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Column_1 as string,",
				"          Column_2 as string,",
				"          Column_3 as string,",
				"          Column_4 as string,",
				"          Column_5 as string,",
				"          Column_6 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readDataflow",
				"readDataflow derive(YEAR = toString(byName('YEAR')),",
				"          MONTH = toString(byName('MONTH')),",
				"          INVOICEID = toString(byName('INVOICEID')),",
				"          COUNTRY = toString(byName('COUNTRY')),",
				"          REGION = toString(byName('REGION')),",
				"          SALES = toString(byName('SALES'))) ~> MapDrifted1"
			]
		}
	}
}