{
	"name": "DerivedColoum",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_OrderNew",
						"type": "DatasetReference"
					},
					"name": "DerivedCOloum"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderDate as date 'dd/MM/yyyy',",
				"          ProductKey as short,",
				"          Country as string,",
				"          EnglishProductName as string,",
				"          SalesAmount as double,",
				"          TaxAmt as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DerivedCOloum",
				"DerivedCOloum derive(year = year(OrderDate),",
				"          month = month(datetime),",
				"          day = dayOfMonth(OrderDate),",
				"          MonthName = ERROR_FUNCTION('')) ~> derivedColumn"
			]
		}
	}
}